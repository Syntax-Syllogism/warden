# @syntax-syllogism/docs-theme is published only to GitHub Packages, and yarn v1
# sends the GitHub token from ~/.npmrc only when the scope is mapped to that
# registry. Other @syntax-syllogism deps (e.g. warden-core) are public-npm only
# and stay pinned to registry.yarnpkg.com URLs in yarn.lock. To add or upgrade
# one of those, override the mapping for that command:
#   npm_config_@syntax-syllogism:registry=https://registry.npmjs.org yarn add <pkg>
@syntax-syllogism:registry=https://npm.pkg.github.com
